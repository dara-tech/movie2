# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/moviestream

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# TMDB API Configuration (optional - for movie data)
# Get your API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Gemini AI Configuration
# Gemini 3 Flash was released Dec 2025 - use gemini-2.0-flash-exp or gemini-3.0-flash when available
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-exp

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# Site URL for sitemap generation and public links
# This should be your production domain (e.g., https://moviestream.cc)
SITE_URL=https://moviestream.cc

# Open Graph / Twitter (optional). Client build: REACT_APP_TWITTER_SITE, REACT_APP_TWITTER_CREATOR
# Server share HTML (/api/share/...): TWITTER_SITE, TWITTER_CREATOR (or reuse REACT_APP_* if set in env)
# TWITTER_SITE=@YourBrand
# TWITTER_CREATOR=@YourPerson

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration (for password reset)
# Option 1: SMTP (Production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="MovieStream" <your-email@gmail.com>

# Option 2: Ethereal Email (Development/Testing)
# Leave SMTP_HOST empty to use Ethereal Email for testing
# ETHEREAL_USER=auto-generated
# ETHEREAL_PASS=auto-generated

# Auto-Reload Configuration (Production only)
# URL to ping every 14 minutes to prevent server sleep
# Should point to your server's health endpoint
# Only works in production mode (NODE_ENV=production)
AUTO_RELOAD_URL=https://movie-7zq4.onrender.com/api/health

# Telegram Bot Configuration (optional - for new movie/TV show notifications)
# Get your bot token from @BotFather on Telegram
# Get your chat ID by messaging your bot and visiting: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Twitter/X API Configuration (optional - for daily top movie posts)
# Get your API credentials from https://developer.twitter.com/en/portal/dashboard
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# Reddit Bot Configuration (optional - for auto-posting new movies and TV shows)
# Register a personal script app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_SUBREDDIT=your_subreddit_here

# Pinterest API Configuration (optional - for auto-pinning movie posters)
# Create an app at https://developers.pinterest.com/apps/ with Business account
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_BOARD_ID=your_pinterest_board_id_here

# Bluesky Bot Configuration (optional - for auto-broadcasting to Bluesky)
# Generate an App Password in bsky.app > Settings > Privacy and Security > App Passwords
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_app_password_here



